# Database Configuration (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=spms_db

# Least-privilege runtime application user (SELECT, INSERT, UPDATE, DELETE only)
DB_USER=spms_app
DB_PASSWORD=<YOUR_MYSQL_APP_PASSWORD>

# Migration user (used solely for schema provisioning / migrations)
DB_MIGRATION_USER=spms_migrator
DB_MIGRATION_PASSWORD=<YOUR_MYSQL_MIGRATION_PASSWORD>

# Application Security & Environment
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
ENVIRONMENT=development
SECRET_KEY=<YOUR_64_CHAR_HEX_SECRET_KEY>
SESSION_MAX_AGE_SECONDS=7200
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT=10/minute

# File Storage (Absolute path or relative to project root, outside web-accessible directory)
UPLOAD_DIR=storage

# Topic Duplicate Detection Threshold (0.00 to 1.00)
DUPLICATE_THRESHOLD=0.70

# Initial Admin Password (Optional: leave empty for seed.py to generate a random password)
ADMIN_INITIAL_PASSWORD=
